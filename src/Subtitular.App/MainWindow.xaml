<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Subtitular.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Subtitular.App"
    Title="Subtitular">
    <Grid x:Name="Root" Padding="20" RowSpacing="14" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderThickness="2" CornerRadius="8" Padding="16" MinHeight="90"
                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                <Button Content="Elegir…" Click="OnChoose" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="FileName" Text="Suelta aquí un video o un audio" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Name="FileInfo" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
            <ComboBox x:Name="LanguageBox" Header="Idioma del audio" MinWidth="170" />
            <ComboBox x:Name="FormatBox" Header="Formato" MinWidth="100" SelectedIndex="0">
                <ComboBoxItem Content="SRT" Tag="srt" />
                <ComboBoxItem Content="VTT" Tag="vtt" />
            </ComboBox>
            <ComboBox x:Name="TranslateBox" Header="Traducir a…" MinWidth="200" />
            <CheckBox x:Name="SpeakBox" Content="Leer en voz alta (WAV junto al video)" VerticalAlignment="Bottom" />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
            <TextBox x:Name="OutputDirBox" Header="Carpeta de salida" PlaceholderText="Junto al video" MinWidth="460" />
            <Button Content="Carpeta…" Click="OnChooseFolder" VerticalAlignment="Bottom" />
        </StackPanel>

        <Grid Grid.Row="3" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="RunButton" Content="Generar subtítulos" Style="{ThemeResource AccentButtonStyle}" Click="OnRun" IsEnabled="False" />
            <Button x:Name="CancelButton" Grid.Column="1" Content="Cancelar" Click="OnCancel" IsEnabled="False" />
            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="4">
                <TextBlock x:Name="StageText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <ProgressBar x:Name="Progress" Maximum="100" />
            </StackPanel>
        </Grid>

        <ListView Grid.Row="4" x:Name="CueList" SelectionMode="None" IsItemClickEnabled="False"
                  BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="8" Padding="8">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:CueItem">
                    <Grid ColumnSpacing="12" Padding="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind Time}" FontFamily="Consolas" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBox Grid.Column="1" Text="{x:Bind Text, Mode=TwoWay}" TextWrapping="Wrap" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="5" Spacing="8">
            <InfoBar x:Name="Notice" IsOpen="False" IsClosable="True" />
            <Button x:Name="SaveButton" Content="Guardar" Click="OnSave" IsEnabled="False" HorizontalAlignment="Right" />
        </StackPanel>
    </Grid>
</Window>
